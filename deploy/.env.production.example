# Browser-reachable PocketBase URL (HTTPS via Synology reverse proxy).
VITE_POCKETBASE_URL=https://pocketbase.savige.me

# Optional
# VITE_APP_BUILD=prod

# Shared secret for Cloudflare Email Routing → POST /api/waypoint/email-inbound
# BOOKING_EMAIL_WEBHOOK_SECRET=generate-a-long-random-string

# AeroDataBox (RapidAPI) key for Polarsteps-style flight lookup
# Free Basic plan: https://rapidapi.com/aedbx-aedbx/api/aerodatabox — show “Data by AeroDataBox”
AERODATABOX_RAPIDAPI_KEY=
