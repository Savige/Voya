# Copy to deploy/.env (recommended — Compose loads it automatically) or deploy/.env.production
# (then use: docker compose -f deploy/docker-compose.yml --env-file deploy/.env.production ...).
# Never commit real env files.
# After editing: docker compose -f deploy/docker-compose.yml up -d --build
# Optional: set VITE_APP_BUILD to override the bottom-right label entirely (otherwise each build auto-sets #buildNumber · UTC date).
# Docker: if BUILD_NUMBER is unset, the image build uses UTC yyyymmddHHMMSS; pass BUILD_NUMBER in compose/CI when you want a pipeline id.

VITE_SUPABASE_URL=https://api.ryansavige.com
VITE_SUPABASE_ANON_KEY=your_anon_key_from_self_hosted_supabase
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key
VITE_GOOGLE_MAPS_MAP_ID=
