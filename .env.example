VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_MAPS_MAP_ID=your_google_maps_map_id

# Notes:
# - Enable Maps JavaScript API and Places API in Google Cloud.
# - Enable billing on the Google Cloud project.
# - Add allowed HTTP referrers (for local dev include http://localhost:*).
# - Peak season weather uses Open-Meteo climate API (free, no additional key required).
