VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_MAPS_MAP_ID=your_google_maps_map_id

# Supabase (optional — when both are set, auth and trips sync to the cloud)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Dev only: on localhost/127.0.0.1, login is skipped automatically (local trip storage).
# Set VITE_DEV_AUTH_BYPASS=0 to test Supabase sign-in on localhost. Set VITE_DEV_AUTH_BYPASS=1 to force bypass when using a LAN IP (e.g. 192.168.x.x).
# VITE_DEV_AUTH_BYPASS=0

# Notes:
# - Enable Maps JavaScript API and Places API in Google Cloud.
# - Enable billing on the Google Cloud project.
# - Add allowed HTTP referrers (for local dev include http://localhost:*).
# - Peak season weather uses Open-Meteo climate API (free, no additional key required).
# - Supabase: create a project, run supabase/migrations/001_user_trips_and_profiles.sql in the SQL Editor,
#   then paste Project URL and anon key from Project Settings → API. Never expose the service_role key in the client.
